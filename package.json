{
  "name": "snapshot-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "typecheck": "pnpm -r --filter './packages/*' run typecheck",
    "clean": "pnpm -r run clean",
    "dev:demo": "pnpm --filter vite-react-demo dev",
    "build:demo": "pnpm build && pnpm --filter vite-react-demo build"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=18"
  }
}
