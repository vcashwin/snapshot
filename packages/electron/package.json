{
  "name": "@snapshot/electron",
  "version": "0.1.0",
  "description": "Electron clipboard adapter for @snapshot/core",
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "exports": {
    "./clipboard": {
      "types": "./dist/clipboard.d.ts",
      "import": "./dist/clipboard.js"
    },
    "./inject": {
      "types": "./dist/inject.d.ts",
      "import": "./dist/inject.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "electron": ">=28"
  },
  "dependencies": {
    "@snapshot/core": "workspace:*"
  },
  "devDependencies": {
    "electron": "^35.2.0"
  },
  "keywords": ["snapshot", "electron", "clipboard"],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
