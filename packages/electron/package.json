{
  "name": "@paper-snapshot/electron",
  "version": "0.1.1",
  "description": "Electron clipboard adapter for @paper-snapshot/core",
  "homepage": "https://github.com/vcashwin/paper-snapshot#readme",
  "bugs": {
    "url": "https://github.com/vcashwin/paper-snapshot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vcashwin/paper-snapshot.git",
    "directory": "packages/electron"
  },
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "exports": {
    "./clipboard": {
      "types": "./dist/clipboard.d.ts",
      "import": "./dist/clipboard.js"
    },
    "./inject": {
      "types": "./dist/inject.d.ts",
      "import": "./dist/inject.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "electron": ">=28"
  },
  "dependencies": {
    "@paper-snapshot/core": "workspace:*"
  },
  "devDependencies": {
    "electron": "^39.8.5"
  },
  "keywords": ["snapshot", "electron", "clipboard"],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
